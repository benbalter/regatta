{
  "openapi": "3.1.0",
  "info": {
    "title": "Regatta API",
    "version": "0.1.0",
    "description": "Races, not pull requests: one intent across many repos as competing agent forks that share fixes, reviewed once per outcome cluster, with an andon cord and decision provenance on every landed line.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/license/mit"
    },
    "contact": {
      "name": "Ben Balter",
      "url": "https://ben.balter.com"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "races",
      "description": "Start and inspect races."
    },
    {
      "name": "review",
      "description": "Review once per outcome cluster."
    },
    {
      "name": "andon",
      "description": "Stop the line, and restart it."
    },
    {
      "name": "why",
      "description": "Decision provenance for any landed line."
    }
  ],
  "components": {
    "securitySchemes": {
      "admin": {
        "type": "http",
        "scheme": "bearer",
        "description": "REGATTA_ADMIN_TOKEN, or a Cloudflare Access session (Cf-Access-Jwt-Assertion), which also records your verified identity as the approver. Required for anything that spends money or writes to repos."
      }
    },
    "schemas": {
      "RaceSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "intent",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "RaceSpec": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "What every agent should accomplish in each repo"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Target"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2,
            "description": "Competing agent forks per repo"
          },
          "setup": {
            "type": "string",
            "maxLength": 1000,
            "default": "",
            "description": "Shell command that installs dependencies, e.g. `npm ci` or `bundle install`; repos can override"
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Shell command that defines passing, e.g. `npm test`; repos can override"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          }
        },
        "required": [
          "intent",
          "targets",
          "check"
        ]
      },
      "Target": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
            "description": "Display name, e.g. `jekyll-titles-from-headings`"
          },
          "url": {
            "type": "string",
            "description": "Public HTTPS git URL to import from"
          },
          "branch": {
            "type": "string"
          },
          "setup": {
            "type": "string",
            "maxLength": 1000,
            "description": "Overrides the race's setup command for this repo"
          },
          "check": {
            "type": "string",
            "maxLength": 1000,
            "description": "Overrides the race's check command for this repo"
          }
        },
        "required": [
          "name",
          "url"
        ]
      },
      "Policy": {
        "type": "object",
        "properties": {
          "requireReviewPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Globs that always need a human, e.g. `lib/**`"
          },
          "maxAutoDiffSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Larger diffs (lines changed per attempt) need a human"
          }
        },
        "required": [
          "requireReviewPaths",
          "maxAutoDiffSize"
        ]
      },
      "Race": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/RaceSpec"
          },
          "createdAt": {
            "type": "string"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "clusters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cluster"
            }
          },
          "fixes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Fix"
            }
          },
          "approved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "halt": {
            "$ref": "#/components/schemas/Halt"
          },
          "repoHalts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Halt"
            },
            "description": "Repos an agent stopped, without stopping the race"
          },
          "usage": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "description": "Model tokens across the race"
              }
            ]
          },
          "feed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedEvent"
            },
            "description": "Newest last; the most recent 300"
          },
          "decisionDocs": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DecisionDoc"
            },
            "description": "Cluster key → decision doc, for clusters escalated to review"
          },
          "sync": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "imported",
                        "up-to-date",
                        "fast-forwarded",
                        "merged",
                        "conflict",
                        "failed"
                      ]
                    },
                    {
                      "type": "string",
                      "enum": [
                        "syncing"
                      ]
                    }
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "detail"
              ]
            }
          }
        },
        "required": [
          "id",
          "spec",
          "createdAt",
          "attempts",
          "clusters",
          "fixes",
          "approved",
          "halt",
          "repoHalts",
          "usage",
          "feed",
          "decisionDocs",
          "sync"
        ]
      },
      "Attempt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "fork": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "done",
              "halted",
              "landing",
              "landed",
              "land-failed"
            ]
          },
          "retryOf": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when this attempt is a coordinated retry or a relaunch"
          },
          "hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fixes from other agents this attempt was seeded with"
          },
          "report": {
            "$ref": "#/components/schemas/AttemptReport"
          },
          "announcement": {
            "$ref": "#/components/schemas/Announcement"
          },
          "candidateFix": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "signature": {
                "type": "string"
              },
              "errorLog": {
                "type": "string"
              },
              "diff": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "signature",
              "errorLog",
              "diff",
              "rationale"
            ],
            "description": "A fix the agent found mid-attempt; shared only if the verify sandbox reproduces it green"
          },
          "undeclared": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Changed files the announcement didn't cover"
          },
          "landedSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "landError": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target",
          "base",
          "fork",
          "state",
          "retryOf",
          "hints",
          "report",
          "announcement",
          "candidateFix",
          "undeclared",
          "landedSha",
          "landError",
          "createdAt"
        ]
      },
      "AttemptReport": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "green": {
            "type": "boolean"
          },
          "changedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failureLog": {
            "type": "string"
          },
          "diffSize": {
            "type": "integer"
          },
          "diff": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "alternatives": {
            "type": "string"
          },
          "headSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "turns": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "halted": {
            "type": "boolean",
            "description": "Stopped because the andon cord was pulled"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "attemptId",
          "target",
          "green",
          "changedFiles",
          "failureLog",
          "diffSize",
          "diff",
          "summary",
          "rationale",
          "problem",
          "alternatives",
          "headSha",
          "turns"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "integer"
          },
          "outputTokens": {
            "type": "integer"
          },
          "cacheReadTokens": {
            "type": "integer"
          }
        },
        "required": [
          "inputTokens",
          "outputTokens",
          "cacheReadTokens"
        ],
        "description": "Model tokens an attempt used"
      },
      "Announcement": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "plan": {
            "type": "string",
            "description": "What the agent intends to do in this repo, before it does it"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Files, directories or globs it expects to touch"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "plan",
          "paths",
          "at"
        ],
        "description": "Work loudly: an agent's plan, posted before its first edit."
      },
      "Cluster": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "green",
              "failing",
              "no-op"
            ]
          },
          "label": {
            "type": "string"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attemptId": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "green": {
                  "type": "boolean"
                },
                "changedFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "failureLog": {
                  "type": "string"
                },
                "diffSize": {
                  "type": "integer"
                }
              },
              "required": [
                "attemptId",
                "target",
                "green",
                "changedFiles",
                "failureLog",
                "diffSize"
              ]
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "winners": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Target → default winning attempt (smallest green diff)"
          },
          "conflicts": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClaimConflict"
              }
            },
            "description": "Target → overlapping claims from other races in that repo"
          }
        },
        "required": [
          "key",
          "kind",
          "label",
          "attempts",
          "targets",
          "verdict",
          "winners",
          "conflicts"
        ],
        "description": "Attempts that ended the same way. Humans review once per cluster, not once per repo."
      },
      "Verdict": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "auto",
              "review",
              "blocked"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "decision",
          "reasons"
        ]
      },
      "ClaimConflict": {
        "type": "object",
        "properties": {
          "race": {
            "type": "string"
          },
          "attempt": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "This attempt's claims that overlap the other race's"
          },
          "theirs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plan": {
            "type": "string"
          },
          "landed": {
            "type": "boolean",
            "description": "The other race already landed this work"
          }
        },
        "required": [
          "race",
          "attempt",
          "paths",
          "theirs",
          "plan",
          "landed"
        ],
        "description": "Another race has announced overlapping work in the same repo."
      },
      "Fix": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "attemptId": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "signature": {
            "type": "string",
            "description": "Normalized error this fix resolved"
          },
          "errorLog": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Every blackboard fix was reproduced green in a fresh sandbox"
          }
        },
        "required": [
          "id",
          "attemptId",
          "target",
          "signature",
          "errorLog",
          "diff",
          "rationale",
          "createdAt",
          "verified"
        ],
        "description": "A blackboard entry: one agent's fix, offered to every agent that hits the same error."
      },
      "Halt": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "by": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "target": {
            "type": "string",
            "description": "Set when only one repo is stopped (an agent's cord); absent when the whole race is"
          }
        },
        "required": [
          "by",
          "reason",
          "at"
        ],
        "description": "The andon cord: who stopped the line, and why."
      },
      "FeedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sync",
              "launch",
              "announce",
              "conflict",
              "fix",
              "retry",
              "finish",
              "halt",
              "resume",
              "decision",
              "land",
              "cache",
              "warm"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "at",
          "kind",
          "target",
          "attempt",
          "text"
        ],
        "description": "One line in the race's live feed."
      },
      "DecisionDoc": {
        "type": "object",
        "properties": {
          "clusterKey": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "description": "The attempt ids this doc was written about; new attempts make it stale"
          },
          "problem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attempt": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "tradeoffs": {
                  "type": "string"
                }
              },
              "required": [
                "attempt",
                "target",
                "summary",
                "tradeoffs"
              ]
            }
          },
          "recommendation": {
            "type": "string"
          },
          "ask": {
            "type": "string",
            "description": "What the reviewer is actually being asked to decide"
          },
          "dissent": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "argument": {
                "type": "string"
              },
              "strongestAlternative": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            },
            "required": [
              "argument",
              "strongestAlternative",
              "model"
            ],
            "description": "A second model's case against the recommendation. Approval must answer it."
          },
          "model": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string"
          }
        },
        "required": [
          "clusterKey",
          "basis",
          "problem",
          "options",
          "recommendation",
          "ask",
          "dissent",
          "model",
          "generatedAt"
        ],
        "description": "One page for the human: the decision, not the diffs."
      },
      "ApproveRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Cluster key from the race view"
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Target → attempt id, to pick a different fork than the default winner"
          },
          "approvedBy": {
            "type": "string"
          },
          "dissentResponse": {
            "type": "string",
            "description": "Required when the cluster's decision doc has a dissent: your answer to it, saved on each landing merge"
          }
        },
        "required": [
          "key"
        ]
      },
      "HaltRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ResumeRequest": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          }
        }
      },
      "WhyAnswer": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "commit": {
            "type": "object",
            "properties": {
              "sha": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "trailers": {
                "type": "object",
                "properties": {
                  "race": {
                    "type": "string"
                  },
                  "attempt": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string"
                  },
                  "problem": {
                    "type": "string"
                  },
                  "alternatives": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string"
                  },
                  "approvedBy": {
                    "type": "string"
                  },
                  "dissent": {
                    "type": "string"
                  },
                  "dissentResponse": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "sha",
              "author",
              "date",
              "subject",
              "trailers"
            ]
          },
          "landing": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "sha": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "trailers": {
                "type": "object",
                "properties": {
                  "race": {
                    "type": "string"
                  },
                  "attempt": {
                    "type": "string"
                  },
                  "intent": {
                    "type": "string"
                  },
                  "problem": {
                    "type": "string"
                  },
                  "alternatives": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string"
                  },
                  "approvedBy": {
                    "type": "string"
                  },
                  "dissent": {
                    "type": "string"
                  },
                  "dissentResponse": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "sha",
              "subject",
              "trailers"
            ]
          }
        },
        "required": [
          "repo",
          "path",
          "line",
          "text",
          "commit",
          "landing"
        ],
        "description": "Why a line exists: the agent's reasoning, and the human or policy decision that landed it."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/races": {
      "get": {
        "operationId": "listRaces",
        "summary": "List races, newest first",
        "tags": [
          "races"
        ],
        "security": [],
        "responses": {
