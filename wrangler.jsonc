{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "regatta",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Astro dashboard (dist/) is served as static assets. These paths run the Worker first.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/agents/*", "/openapi.json"] },
  "build": { "command": "npm run build:web" },
  "durable_objects": {
    "bindings": [
      { "name": "Race", "class_name": "Race" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "exports": {
    "Race": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
    }
  ],
  // Workers AI, for the dissenting reviewer (a different model family from the agents).
  "ai": { "binding": "AI" },
  // Installed-dependency cache for sandboxes (see src/cache.ts).
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "regatta-cache" }],
  "workflows": [
    { "name": "regatta-attempt", "binding": "ATTEMPT", "class_name": "AttemptWorkflow" },
    { "name": "regatta-land", "binding": "LAND", "class_name": "LandWorkflow" },
    { "name": "regatta-sync", "binding": "SYNC", "class_name": "SyncWorkflow" },
    { "name": "regatta-decision", "binding": "DECISION", "class_name": "DecisionWorkflow" }
  ],
  "vars": {
    // "provider:model" per role. Local dev runs free on Ollama; production uses Claude via AI Gateway.
    "REGATTA_AGENT_MODEL": "ollama:qwen3.6",
    "REGATTA_DISSENT_MODEL": "ollama:gemma4",
    "OLLAMA_URL": "http://localhost:11434",
    // Local dev: the Artifacts binding is remote-only, so point at scripts/fake-artifacts.ts.
    "FAKE_ARTIFACTS_URL": "http://localhost:8790",
    "FAKE_ARTIFACTS_HOST": "artifacts.regatta.local"
  },
  "env": {
    // Real Artifacts. Needs Workers Paid: `wrangler deploy --env production`.
    "production": {
      "vars": {
        "REGATTA_AGENT_MODEL": "anthropic:claude-opus-5-5",
        // A different model family argues against Claude's recommendation.
        "REGATTA_DISSENT_MODEL": "workers-ai:@cf/moonshotai/kimi-k2.6",
        "OLLAMA_URL": "",
        "FAKE_ARTIFACTS_URL": "",
        "FAKE_ARTIFACTS_HOST": ""
      },
      "ai": { "binding": "AI" },
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "regatta" }],
      "durable_objects": {
        "bindings": [
          { "name": "Race", "class_name": "Race" },
          { "name": "SANDBOX", "class_name": "Sandbox" }
        ]
      },
      "containers": [
        {
          "class_name": "Sandbox",
          "scheduling_policy": "durable_object",
          "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
        }
      ],
      // Installed-dependency cache for sandboxes (see src/cache.ts).
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "regatta-cache" }],
  "workflows": [
        { "name": "regatta-attempt", "binding": "ATTEMPT", "class_name": "AttemptWorkflow" },
        { "name": "regatta-land", "binding": "LAND", "class_name": "LandWorkflow" },
    { "name": "regatta-sync", "binding": "SYNC", "class_name": "SyncWorkflow" },
    { "name": "regatta-decision", "binding": "DECISION", "class_name": "DecisionWorkflow" }
      ]
    }
  }
}
